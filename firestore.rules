rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // USERS
    // =========================
    match /users/{userId} {

      // A user can only read their own account document.
      allow read: if request.auth != null
                  && request.auth.uid == userId;

      // A user can create only their own account document.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == request.auth.uid;

      // A user can update their own account document.
      // Pro/payment fields cannot be changed from the client.
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.isPro == resource.data.isPro
                    && request.resource.data.proExpiresAt == resource.data.proExpiresAt;

      // Users cannot delete their account document from the client.
      allow delete: if false;
    }


    // =========================
    // CLIENTS
    // =========================
    match /clients/{clientId} {

      // User can create a client only for themselves.
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      // User can only read their own clients.
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      // User can update only their own clients.
      // Ownership cannot be transferred to another user.
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId;

      // User can delete only their own clients.
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }
  }
}
